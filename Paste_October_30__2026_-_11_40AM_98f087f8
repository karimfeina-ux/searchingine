          notes: 'Turns the city you type into a search area.'
        }
      ],
      estimatedMonthlySpend: 0,
      dailyBudgetCap: 0,
      manualResearchModeAvailable: true
    });
  }

  return jsonResponse({ error: 'Endpoint not found' }, 404);
}
